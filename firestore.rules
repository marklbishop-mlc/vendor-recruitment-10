rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =======================================================
    // [MLC Vendor Recruitment] Rules
    // Target Database: mlc-vendor-recruitment-db
    // =======================================================

    // Helper functions for Role-Based Access Control
    function isAuthed() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthed() && getUserData().role == 'admin';
    }

    function isManager() {
      return isAuthed() && (getUserData().role == 'manager' || getUserData().role == 'admin');
    }

    // Default lockdown for undefined collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow read: if isAuthed() && getUserData().role == 'admin';
      allow write: if isAuthed() && request.auth.uid == userId;
      allow write: if isAuthed() && getUserData().role == 'admin';
      allow create: if isAuthed() && request.auth.uid == userId;
    }

    // Vendors Collection (Supports Public Intake & NDA Signing Portal)
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if true;
      allow update: if isManager() || request.resource.data.diff(resource.data).affectedKeys().hasAny(['hasSignedNda', 'ndaSignedAt', 'ndaSignatureName', 'stageStatus', 'updatedAt']);
      allow delete: if isManager();
    }

    // Templates Collection (Admin manages, Public/Manager can read)
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tests Collection (Graders/Managers manage test assignments)
    match /tests/{testId} {
      allow read, write: if true;
    }

    // Notifications Collection (Communication logs & mail queue)
    match /notifications/{notificationId} {
      allow read: if isManager();
      allow create, update: if true;
      allow delete: if isManager();
    }

    // Workflow Actions Collection (Admin manages, Public/Manager can read)
    match /workflow_actions/{actionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs Collection (Managers can write, Admins can manage)
    match /audit_logs/{logId} {
      allow read: if isManager();
      allow write: if true;
    }

    // Settings Collection (Global system configuration: languages, stages, statuses, testing mode)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Applications Collection (Public can read active configs, staff/managers can manage)
    match /applications/{appId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
