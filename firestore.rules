rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =======================================================
    // [MLC Vendor Recruitment] Rules
    // Target Database: mlc-vendor-recruitment-db
    // =======================================================

    // Helper functions for Role-Based Access Control
    function isAuthed() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthed() && getUserData().role == 'admin';
    }

    function isManager() {
      return isAuthed() && (getUserData().role == 'manager' || getUserData().role == 'admin');
    }

    // Default lockdown for undefined collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow read: if isAuthed() && getUserData().role == 'admin';
      allow write: if isAuthed() && request.auth.uid == userId;
      allow write: if isAuthed() && getUserData().role == 'admin';
      allow create: if isAuthed() && request.auth.uid == userId;
    }

    // Vendors Collection
    match /vendors/{vendorId} {
      // Basic User (Read-Only) can only see approved vendors. Admin/Manager can see all.
      allow read: if isAuthed() && (isManager() || resource.data.status == 'approved');
      allow write: if isManager();
    }

    // Templates Collection (Admin manages, Manager can read to trigger)
    match /templates/{templateId} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    // Tests Collection (Graders/Managers manage test assignments)
    match /tests/{testId} {
      allow read, write: if isManager();
    }

    // Notifications Collection (Communication logs & mail queue)
    match /notifications/{notificationId} {
      allow read, write: if isManager();
    }

    // Workflow Actions Collection (Admin manages, Manager can read)
    match /workflow_actions/{actionId} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    // Audit Logs Collection (Managers can write, Admins can manage)
    match /audit_logs/{logId} {
      allow read: if isManager();
      allow write: if isManager();
    }
  }
}
